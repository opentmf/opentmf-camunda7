# Download OpenTelemetry Java agent
ARG OTEL_AGENT_VERSION=2.21.0
FROM alpine:3.20 AS otel-agent
ARG OTEL_AGENT_VERSION
RUN apk add --no-cache curl \
    && curl -fsSL -o /opentelemetry-javaagent.jar \
    "https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v${OTEL_AGENT_VERSION}/opentelemetry-javaagent.jar"

# Stage 1: Build the JAR using Maven
FROM maven:3.9.9-eclipse-temurin-17 AS maven-build
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn -Dmaven.test.skip=true -Dmaven.javadoc.skip=true -Dmaven.source.skip=true -P repackage clean package

# Stage 2: Extract layers using layertools
FROM eclipse-temurin:17-jre-jammy AS layer-extract
WORKDIR /application
COPY --from=maven-build /build/target/*.jar application.jar
RUN java -Djarmode=layertools -jar application.jar extract

# Stage 3: Final runtime image
FROM eclipse-temurin:17-jre-jammy
RUN apt-get update && \
    apt-get install -y curl iputils-ping procps rsync && \
    rm -rf /var/lib/apt/lists/* && \
    addgroup java && \
    adduser --ingroup java --disabled-password java
USER java
WORKDIR /application
COPY --chown=java:java --from=layer-extract /application/dependencies/ ./
COPY --chown=java:java --from=layer-extract /application/spring-boot-loader/ ./
COPY --chown=java:java --from=layer-extract /application/snapshot-dependencies/ ./
COPY --chown=java:java --from=layer-extract /application/application/ ./

# copy opentelemetry java agent
COPY --from=otel-agent /opentelemetry-javaagent.jar /addons/opentelemetry-javaagent.jar
ENV OTEL_AGENT_PATH=/addons/opentelemetry-javaagent.jar

# set minimal JVM options
ENV SERVER_PORT=8080
EXPOSE ${SERVER_PORT}
ENV JVM_OPTS="-Duser.timezone=UTC"
ENV JVM_OPTS="${JVM_OPTS} -Dserver.port=${SERVER_PORT}"

ENTRYPOINT ["sh","-lc","exec java ${JAVA_TOOL_OPTIONS} ${JVM_OPTS} org.springframework.boot.loader.launch.JarLauncher"]
CMD []
